#!/bin/sh
app_path=$0
while [ -h "$app_path" ]; do
    ls=$(ls -ld "$app_path")
    link=${ls#*' -> '}
    case $link in /*) app_path=$link ;; *) app_path=$(dirname "$app_path")/$link ;; esac
done
APP_HOME=$(cd -P "${app_path%/*}" > /dev/null && pwd)
APP_BASE_NAME=$(basename "$app_path")
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
if [ -n "$JAVA_HOME" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVA_EXE" ]; then
        echo "ERROR: JAVA_HOME invalid"
        exit 1
    fi
else
    JAVA_EXE=java
    if ! command -v java > /dev/null 2>&1; then
        echo "ERROR: JAVA_HOME not set"
        exit 1
    fi
fi
exec "$JAVA_EXE" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "" -jar "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" "$@"
